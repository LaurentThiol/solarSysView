# Copier vers .env et coller l'URL Neon (jamais commitée).
# Console Neon → projet Synchro → Connection string (pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Serveur local (python -m synchro serve ou ./launch)
HOST=127.0.0.1
PORT=8000

# UI Next.js (injecté par ./launch)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Page /admin — laissez vide en local (127.0.0.1). Obligatoire si l’UI est publique.
ADMIN_PASSWORD=

# Google AI Studio / Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Brave Search — https://api-dashboard.search.brave.com/app/keys
BRAVE_API_KEY=

