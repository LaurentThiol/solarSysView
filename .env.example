# Copier vers .env et coller l'URL Neon (jamais commitée).
# Console Neon → projet Synchro → Connection string (pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Serveur local (python -m synchro serve ou ./launch)
# ./launch lit HOST/PORT ici si SYNCHRO_BACKEND_HOST / SYNCHRO_BACKEND_PORT ne sont pas exportés.
HOST=127.0.0.1
PORT=8000

# LLM local (Ollama ou llama-server compatible OpenAI). Brain l’utilise par défaut.
# Jamais de bascule automatique vers Gemini / OpenAI si ce serveur est down.
OLLAMA_HOST=http://127.0.0.1:11434
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=qwen2.5:7b
# OLLAMA_NUM_CTX=16384
# Pull manuel recommandé (plusieurs Go, pas via ./launch) :
#   ollama pull qwen2.5:7b
#   ollama pull qwen2.5vl:7b   # IA locale : passe visuel, puis qwen2.5:7b raisonne
#   ollama pull qwen3:8b    # si GPU, thinking
# Deux 7B (~6 Go Q4 chacun) se swapent si la VRAM ne tient pas les deux.
# IA_LOCAL_TWO_PASS=0       # une passe VLM (image + pack) au lieu de voir puis raisonner
# MORPHO_VLM_MODEL=qwen2.5vl:7b

# UI Next.js (injecté par ./launch)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Page /admin — laissez vide en local (127.0.0.1). Obligatoire si l’UI est publique.
ADMIN_PASSWORD=

# Google AI Studio / Gemini — https://aistudio.google.com/apikey
# Utilisée par l’onglet IA (lecture de capture).
GOOGLE_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# Utilisée par l’onglet IA (lecture de capture).
OPENAI_API_KEY=

# Brave Search — https://api-dashboard.search.brave.com/app/keys
BRAVE_API_KEY=

# Morpho VLM : ollama pull qwen2.5vl:7b (recommandé, ancrage cases/boîtes).
# Repli léger : ollama pull moondream. Sinon transformers + Moondream2 via ./launch install-vlm.
# MORPHO_VLM_NO_INSTALL=1  # ne pas pip-installer depuis le bouton
# MORPHO_GGUF_PATH=/chemin/vers/moondream.gguf

