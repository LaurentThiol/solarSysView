llm_configured_host() {
  local host="${LOCAL_LLM_BASE_URL:-${OLLAMA_HOST:-}}"
  if [[ -z "$host" && -f "$ROOT/.env" ]]; then
    host="$(dotenv_value LOCAL_LLM_BASE_URL)"
    [[ -n "$host" ]] || host="$(dotenv_value OLLAMA_HOST)"
  fi
  host="${host:-http://127.0.0.1:11434}"
  host="${host%/}"
  case "$host" in
    http://localhost*) host="http://127.0.0.1${host#http://localhost}" ;;
    https://localhost*) host="https://127.0.0.1${host#https://localhost}" ;;
  esac
  printf '%s' "$host"
}

llm_models_url() {
  if [[ "$1" == */v1 ]]; then
    printf '%s/models' "$1"
  else
    printf '%s/v1/models' "$1"
  fi
}

llm_curl() {
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsS --noproxy '*' --max-time 1 "$1" >/dev/null 2>&1
}

llm_host_up() {
  local try="$1" alt
  [[ -n "$try" ]] || return 1
  alt="$(llm_models_url "$try")"
  llm_curl "${try}/api/tags" || llm_curl "$alt" || llm_curl "${try}/api/version"
}

llm_find_up() {
  local host="$1" try
  for try in "$host" \
    "${host/127.0.0.1/localhost}" \
    "${host/localhost/127.0.0.1}" \
    "${host/127.0.0.1/[::1]}" \
    "http://127.0.0.1:1234" \
    "http://127.0.0.1:1234/v1" \
    "http://127.0.0.1:8080/v1" \
    "http://127.0.0.1:8080"
  do
    [[ -n "$try" ]] || continue
    if llm_host_up "$try"; then
      printf '%s' "$try"
      return 0
    fi
  done
  return 1
}

wait_llm_up() {
  local host="$1" n=0
  while [[ $n -lt 24 ]]; do
    if llm_host_up "$host"; then
      printf '%s' "$host"
      return 0
    fi
    if llm_host_up "${host/127.0.0.1/localhost}"; then
      printf '%s' "${host/127.0.0.1/localhost}"
      return 0
    fi
    n=$((n + 1))
    sleep 0.25
  done
  return 1
}

find_ollama_bin() {
  local c resolved
  if [[ -n "${SYNCHRO_OLLAMA:-}" ]]; then
    if [[ -x "${SYNCHRO_OLLAMA}" ]]; then
      printf '%s\n' "$SYNCHRO_OLLAMA"
      return 0
    fi
    resolved="$(command -v "$SYNCHRO_OLLAMA" 2>/dev/null || true)"
    if [[ -n "$resolved" && -x "$resolved" ]]; then
      printf '%s\n' "$resolved"
      return 0
    fi
    return 1
  fi
  resolved="$(command -v ollama 2>/dev/null || true)"
  if [[ -n "$resolved" && -x "$resolved" ]]; then
    printf '%s\n' "$resolved"
    return 0
  fi
  for c in \
    /usr/local/bin/ollama \
    /opt/homebrew/bin/ollama \
    /usr/bin/ollama \
    "${HOME}/.local/bin/ollama" \
    /Applications/Ollama.app/Contents/Resources/ollama \
    /Applications/Ollama.app/Contents/MacOS/ollama
  do
    if [[ -x "$c" ]]; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  return 1
}

ollama_version_label() {
  local bin="$1" out
  [[ -n "$bin" && -x "$bin" ]] || return 1
  out="$("$bin" --version 2>&1 | tr -d '\r' | head -n 1 || true)"
  if [[ -z "$out" || "$out" == *"not found"* || "$out" == *"No such file"* || "$out" == *"command not found"* ]]; then
    return 1
  fi
  printf '%s' "$out"
}

ollama_howto() {
  cat <<EOF
Ollama n'est pas installé correctement (CLI introuvable ou cassé).
  macOS  : https://ollama.com/download  ou  brew install ollama
           ouvrez Ollama.app une fois pour poser le binaire
  Linux  : curl -fsSL https://ollama.com/install.sh | sh
  Puis   : ollama pull llama3.2
  Autre  : LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1  (LM Studio)
           SYNCHRO_OLLAMA=/chemin/vers/ollama ./launch
  Forcer : SYNCHRO_SKIP_OLLAMA=1 ./launch  (pastille LLM local off)
EOF
}

llm_json_names() {
  local py="$ROOT/.venv/bin/python"
  if [[ ! -x "$py" ]]; then
    py="$(command -v python3 || command -v python || true)"
  fi
  [[ -n "$py" ]] || return 1
  "$py" -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
items = data.get("models") or data.get("data") or []
names = []
for item in items:
    if not isinstance(item, dict):
        continue
    name = item.get("name") or item.get("id") or ""
    if name:
        names.append(str(name))
print(" ".join(names))
'
}

llm_model_names() {
  local host="$1" json names
  [[ -n "$host" ]] || return 1
  json="$(curl -fsS --noproxy '*' --max-time 2 "${host}/api/tags" 2>/dev/null || true)"
  if [[ -z "$json" ]]; then
    json="$(curl -fsS --noproxy '*' --max-time 2 "$(llm_models_url "$host")" 2>/dev/null || true)"
  fi
  [[ -n "$json" ]] || return 1
  names="$(printf '%s' "$json" | llm_json_names 2>/dev/null || true)"
  [[ -n "$names" ]] || return 1
  printf '%s' "$names"
}

ensure_local_llm() {
  LLM_LAUNCH_SUMMARY="non vérifié"
  if [[ "${SYNCHRO_SKIP_OLLAMA:-}" == "1" ]]; then
    info "Ollama : ignoré (SYNCHRO_SKIP_OLLAMA=1)"
    LLM_LAUNCH_SUMMARY="ignoré"
    return 0
  fi
  local host found bin ver names extra cli_ok=0
  host="$(llm_configured_host)"
  found="$(llm_find_up "$host" || true)"
  bin="$(find_ollama_bin || true)"
  if [[ -z "$bin" && "$(uname -s)" == Darwin && -d /Applications/Ollama.app && -z "$found" ]]; then
    info "Ollama.app est installé, CLI encore introuvable — ouverture de l'app…"
    open -a Ollama >/dev/null 2>&1 || true
    found="$(wait_llm_up "$host" || true)"
    bin="$(find_ollama_bin || true)"
  fi
  if [[ -n "$bin" ]]; then
    if ver="$(ollama_version_label "$bin")"; then
      ok "Ollama CLI : ${ver}  (${bin})"
      cli_ok=1
    else
      warn "Ollama trouvé (${bin}) mais « ollama --version » échoue — installation cassée. Réinstallez : https://ollama.com"
      ollama_howto >&2
    fi
  else
    if [[ "$(uname -s)" == Darwin && -d /Applications/Ollama.app ]]; then
      warn "Ollama.app est dans /Applications mais le CLI est introuvable. Ouvrez l'app une fois, ou : brew install ollama"
    elif [[ -n "$found" ]]; then
      printf '%sOllama CLI : absent (le serveur répond déjà — Docker / autre install ?)%s\n' "$C_DIM" "$C_RESET"
    else
      warn "Ollama : CLI introuvable dans PATH ni aux emplacements connus."
      ollama_howto >&2
    fi
  fi

  if [[ -z "$found" && "$cli_ok" -eq 1 ]]; then
    if [[ "$(uname -s)" == Darwin && -d /Applications/Ollama.app ]]; then
      info "Ollama CLI OK mais ${host} refuse la connexion — ouverture d'Ollama.app…"
      open -a Ollama >/dev/null 2>&1 || true
      found="$(wait_llm_up "$host" || true)"
    fi
  fi
  if [[ -z "$found" && "$cli_ok" -eq 1 ]]; then
    info "Démarrage de ollama serve (${host})…"
    mkdir -p "$RUN_DIR"
    (
      trap '' INT
      exec "$bin" serve
    ) >>"$RUN_DIR/ollama.log" 2>&1 &
    found="$(wait_llm_up "$host" || true)"
  fi
  if [[ -z "$found" ]]; then
    if [[ "$cli_ok" -eq 1 ]]; then
      warn "Ollama CLI OK mais le serveur n'écoute pas sur ${host}. Journal : ${RUN_DIR}/ollama.log"
      LLM_LAUNCH_SUMMARY="CLI OK, serveur injoignable (${host})"
    else
      LLM_LAUNCH_SUMMARY="non installé — https://ollama.com"
    fi
    return 0
  fi
  names="$(llm_model_names "$found" || true)"
  if [[ -z "$names" && "$cli_ok" -eq 1 ]]; then
    extra="$("$bin" list 2>/dev/null | awk 'NR>1 && $1 != "" {print $1}' | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    names="$extra"
  fi
  if [[ -z "$names" ]]; then
    warn "Ollama écoute (${found}) mais aucun modèle. Ex. : ${bin:-ollama} pull llama3.2"
    LLM_LAUNCH_SUMMARY="${found} · aucun modèle"
    return 0
  fi
  ok "Ollama serveur : ${found} · ${names}"
  if [[ "$cli_ok" -eq 1 ]]; then
    LLM_LAUNCH_SUMMARY="${ver} · ${found} · ${names}"
  else
    LLM_LAUNCH_SUMMARY="${found} · ${names}"
  fi
}

llm_chat_names() {
  local names="$1" token chat=""
  for token in $names; do
    if printf '%s' "$token" | grep -Eqi 'embed|nomic-embed|tts|whisper|clip|moondream|llava|qwen[^ ]*vl|minicpm-?v|vision'; then
      continue
    fi
    chat="${chat}${chat:+ }${token}"
  done
  printf '%s' "$chat"
}

llm_chat_is_small() {
  local names="$1" token
  [[ -n "$names" ]] || return 0
  for token in $names; do
    if printf '%s' "$token" | grep -Eqi 'llama3\.2|tinyllama|\bphi|:1b([^0-9]|$)|:2b([^0-9]|$)|:3b([^0-9]|$)'; then
      continue
    fi
    return 1
  done
  return 0
}

ollama_doctor() {
  if [[ "${SYNCHRO_SKIP_OLLAMA:-}" == "1" ]]; then
    printf '%sOllama : ignoré (SYNCHRO_SKIP_OLLAMA=1)%s\n' "$C_DIM" "$C_RESET"
    return 0
  fi
  local host found bin ver names
  host="$(llm_configured_host)"
  bin="$(find_ollama_bin || true)"
  if [[ -z "$bin" ]]; then
    if [[ "$(uname -s)" == Darwin && -d /Applications/Ollama.app ]]; then
      warn "Ollama.app est dans /Applications mais le CLI est introuvable — ouvrez l'app une fois."
    else
      warn "Ollama : pas installé (CLI introuvable)."
    fi
    ollama_howto >&2
  elif ! ver="$(ollama_version_label "$bin")"; then
    warn "Ollama : ${bin} présent mais « ollama --version » échoue — réinstallez."
  else
    ok "Ollama CLI : ${ver}  (${bin})"
  fi
  found="$(llm_find_up "$host" || true)"
  if [[ -z "$found" ]]; then
    printf '%sOllama serveur : injoignable (%s) — ./launch le démarrera si le CLI est OK.%s\n' "$C_DIM" "$host" "$C_RESET"
    return 0
  fi
  names="$(llm_model_names "$found" || true)"
  if [[ -n "$names" ]]; then
    ok "Ollama serveur : ${found} · ${names}"
    if printf '%s' "$names" | grep -Eqi 'moondream|llava|qwen[^ ]*vl|minicpm-?v|qwen2\.5vl|llama3\.2-vision'; then
      ok "Morpho VLM : tag vision présent — pas besoin de torch"
    else
      printf '%sMorpho VLM : pas de modèle vision — ollama pull qwen2.5vl:7b (repli : ollama pull moondream)%s\n' "$C_DIM" "$C_RESET"
    fi
    local chat
    chat="$(llm_chat_names "$names")"
    if [[ -z "$chat" ]]; then
      warn "Ollama : pas de modèle de chat (hors vision). Pour Brain : ollama pull qwen2.5:7b"
    elif llm_chat_is_small "$chat"; then
      warn "Ollama : seulement un petit modèle de chat (${chat}). Pour Brain : ollama pull qwen2.5:7b"
    fi
  else
    warn "Ollama écoute (${found}) mais aucun modèle. Ex. : ollama pull llama3.2"
  fi
}

