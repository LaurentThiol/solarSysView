cmd_stop() {
  local graceful=1 force=0 busy=0
  if [[ "${1:-}" == "--force" || "$STOP_FORCE" -eq 1 ]]; then
    graceful=0
    force=1
  fi
  mkdir -p "$RUN_DIR"
  date +%s >"$RUN_DIR/stopped"
  if [[ "$graceful" -eq 1 ]]; then
    request_api_shutdown || true
  fi
  kill_recorded_pid "$RUN_DIR/backend.pid" "$force"
  kill_recorded_pid "$RUN_DIR/frontend.pid" "$force"
  free_port "$BACKEND_PORT" "$force" || busy=1
  free_port "$FRONTEND_PORT" "$force" || busy=1
  rm -f "$RUN_DIR/backend.pid" "$RUN_DIR/frontend.pid"
  if [[ "$busy" -eq 1 ]]; then
    if [[ "$force" -eq 1 ]]; then
      warn "Un port reste occupé après --force."
      return 1
    fi
    warn "Synchro arrêté. Un port reste pris par un autre processus — ./launch stop --force pour forcer."
    return 0
  fi
  ok "Ports ${BACKEND_PORT} et ${FRONTEND_PORT} libérés."
}

