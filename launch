cmd_update() {
  need_cmd git
  if ! git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "Ce dossier n'est pas un clone git. Clonez https://github.com/LaurentThiol/Synchro.git"
  fi
  local current branch remote_url local_sha remote_sha short_local
  current="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  branch="$(git -C "$ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  if [[ "$branch" == origin/* ]]; then
    branch="${branch#origin/}"
  elif [[ -n "$current" && "$current" != "HEAD" ]] && git -C "$ROOT" ls-remote --exit-code origin "refs/heads/${current}" >/dev/null 2>&1; then
    branch="$current"
  else
    branch="main"
  fi
  remote_url="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"
  if [[ "$remote_url" == *github.com* ]]; then
    remote_url="https://github.com/${remote_url#*github.com[:/]}"
    remote_url="${remote_url%.git}"
    remote_url="${remote_url%/}"
  fi
  info "Contrôle GitHub (${remote_url:-origin} · ${branch})…"
  if ! git -C "$ROOT" fetch --quiet origin "$branch"; then
    die "git fetch origin ${branch} a échoué (réseau ou identifiants GitHub)."
  fi
  local_sha="$(git -C "$ROOT" rev-parse HEAD)"
  remote_sha="$(git -C "$ROOT" rev-parse "origin/${branch}" 2>/dev/null || true)"
  if [[ -z "$remote_sha" ]]; then
    die "Branche origin/${branch} introuvable après fetch."
  fi
  short_local="${local_sha:0:7}"
  if [[ "$local_sha" == "$remote_sha" ]]; then
    ok "Déjà à jour (${short_local} = origin/${branch})."
    return 0
  fi
  info "Commits à tirer depuis origin/${branch} :"
  git -C "$ROOT" --no-pager log --oneline "HEAD..origin/${branch}" | head -n 20 || true
  if [[ "$current" != "$branch" ]]; then
    die "Branche locale ${current} — passez sur ${branch} pour appliquer (git checkout ${branch} && ./launch update)."
  fi
  if [[ -n "$(git -C "$ROOT" status --porcelain)" ]]; then
    die "Arbre de travail modifié — committez ou stash avant de mettre à jour."
  fi
  info "git pull --ff-only origin ${branch}…"
  git -C "$ROOT" pull --ff-only origin "$branch" || die "git pull a échoué (historique divergé ?)."
  ok "Code mis à jour ($(git -C "$ROOT" rev-parse --short HEAD))."
  if [[ "$SKIP_INSTALL" -eq 0 ]]; then
    ensure_install
  else
    info "Dépendances non réinstallées (--skip-install)."
  fi
  ok "Relancez ./launch pour prendre en compte le nouveau code."
}

