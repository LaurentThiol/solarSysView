#!/usr/bin/env bash
# Synchro — lanceur local (API Python + UI Next.js) depuis un seul terminal.
# Même modèle que ./paxvideo : install si besoin, vérifications de statut, Ctrl+C = tout arrêter.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN_DIR="${SYNCHRO_RUN_DIR:-$ROOT/.run}"
# Ports : SYNCHRO_* (processus) > HOST/PORT du .env > défauts. Voir apply_launch_defaults.
BACKEND_PORT="${SYNCHRO_BACKEND_PORT:-}"
FRONTEND_PORT="${SYNCHRO_FRONTEND_PORT:-}"
BACKEND_HOST="${SYNCHRO_BACKEND_HOST:-}"
FRONTEND_HOST="${SYNCHRO_FRONTEND_HOST:-}"
FRONTEND_URL=""
BACKEND_URL=""
ALIVE_URL=""
HEALTH_URL=""

SKIP_INSTALL=0
FORCE_INSTALL=0
OPEN_BROWSER=1
STOP_FORCE=0
WAIT_API_RETRIES=240
WAIT_UI_RETRIES=360

if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'
  C_DIM=$'\033[2m'
  C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_CYAN=$'\033[36m'
  C_MAGENTA=$'\033[35m'
else
  C_RESET= C_DIM= C_BOLD= C_RED= C_GREEN= C_YELLOW= C_CYAN= C_MAGENTA=
fi

info() { printf '%s▸%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
ok()   { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
${C_BOLD}Synchro${C_RESET} — lanceur local (EuroMillions)

Usage:
  ./launch                 Démarre API + UI, vérifie Neon / Ollama et rattrape les tirages si besoin
  ./launch start           Idem
  ./launch stop            Arrêt propre (ports ${BACKEND_PORT:-8000} / ${FRONTEND_PORT:-43147})
  ./launch stop --force    Libère les ports même si le processus n'est pas Synchro
  ./launch restart         Arrêt puis start (mêmes options que start)
  ./launch status          Affiche l'état des services (alive, Neon, UI)
  ./launch logs            Dernières lignes des journaux (.run/)
  ./launch logs -f         Suit les journaux (autre terminal)
  ./launch update          Contrôle GitHub et tire origin (ff-only), puis réinstalle si besoin
  ./launch doctor          Diagnostic Python / Node / venv / npm / ports / Neon / VLM / chartisme / harmo / decisionTree / nextData / Ollama
  ./launch install         Installe uniquement les dépendances
  ./launch install-vlm     Installe Moondream via torch (optionnel si ollama pull moondream)
  ./launch install-chartisme  Installe les réseaux du chartisme (torch + torch-geometric)
  ./launch install-harmo      Installe les extras Harmo (PyWavelets, ssqueezepy, librosa)
  ./launch install-nextdata   Installe nextData (LightGBM / Darts, Chronos, torch, matplotlib)
  ./launch install-decision-tree  Répare decisionTree (scikit-learn, dtreeviz, dot). Le démarrage l'installe déjà.
  ./launch chartisme-train    Entraîne les réseaux du chartisme (options passées au CLI)
  ./launch brain-specialist-train  Entraîne un spécialiste Brain (options passées au CLI)
  ./launch shortcut        Installe un raccourci bureau / menu applications
  ./launch help            Cette aide

Options (start / restart):
  --skip-install             Ne pas installer / mettre à jour les dépendances
  --force-install            Forcer pip + npm install
  --no-open                  Ne pas ouvrir le navigateur

Options (logs):
  -f, --follow               Suivre (comme tail -F)
  --api / --ui               Un seul journal
  -n, --lines N              Nombre de lignes (défaut: 80)

Variables (processus > .env > défaut):
  SYNCHRO_BACKEND_HOST       Hôte API (sinon HOST du .env, défaut: 127.0.0.1)
  SYNCHRO_BACKEND_PORT       Port API  (sinon PORT du .env, défaut: 8000)
  SYNCHRO_FRONTEND_HOST      Hôte UI   (défaut: 127.0.0.1)
  SYNCHRO_FRONTEND_PORT      Port UI   (défaut: 43147)
  SYNCHRO_RUN_DIR            Journaux et PID (défaut: .run/)
  SYNCHRO_PYTHON             Interpréteur Python 3.10+ (sinon auto)
  SYNCHRO_OLLAMA             Binaire ollama (sinon PATH + emplacements connus)
  SYNCHRO_SKIP_OLLAMA        1 = ne pas vérifier / démarrer Ollama au start

Arrêt propre : bouton Quitter dans l'UI, Ctrl+C, ou ./launch stop.
EOF
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Commande introuvable : $1. Installez-la puis relancez."
}

python_supported() {
  local exe="$1"
  [[ -n "$exe" ]] || return 1
  if [[ ! -x "$exe" ]]; then
    command -v "$exe" >/dev/null 2>&1 || return 1
  fi
  "$exe" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null
}

node_supported() {
  command -v node >/dev/null 2>&1 || return 1
  node -e 'process.exit(Number.parseInt(process.versions.node, 10) >= 20 ? 0 : 1)' 2>/dev/null
}

python_version_label() {
  local exe="$1"
  [[ -n "$exe" ]] || { printf '?\n'; return 0; }
  "$exe" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || printf '?\n'
}

resolve_python() {
  local c="$1"
  [[ -n "$c" ]] || return 1
  if [[ -x "$c" ]]; then
    printf '%s\n' "$c"
    return 0
  fi
  command -v "$c" 2>/dev/null || return 1
}

collect_python_candidates() {
  local c
  if [[ -n "${SYNCHRO_PYTHON:-}" ]]; then
    printf '%s\n' "$SYNCHRO_PYTHON"
  fi
  for c in python3.13 python3.12 python3.11 python3.10 python3 python; do
    command -v "$c" 2>/dev/null || true
  done
  for c in \
      /opt/homebrew/bin/python3.13 \
      /opt/homebrew/bin/python3.12 \
      /opt/homebrew/opt/python@3.12/bin/python3.12 \
      /usr/local/bin/python3.12 \
      /Library/Frameworks/Python.framework/Versions/3.12/bin/python3.12
  do
    [[ -x "$c" ]] && printf '%s\n' "$c"
  done
}

pick_python() {
  local candidate resolved seen=""
  if [[ -n "${SYNCHRO_PYTHON:-}" ]]; then
    if resolved="$(resolve_python "$SYNCHRO_PYTHON")" && python_supported "$resolved"; then
      printf '%s\n' "$resolved"
      return 0
    fi
    return 1
  fi
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    resolved="$(resolve_python "$candidate")" || continue
    case " $seen " in
      *" $resolved "*) continue ;;
    esac
    seen+=" $resolved"
    if python_supported "$resolved"; then
      printf '%s\n' "$resolved"
      return 0
    fi
  done <<EOF
$(collect_python_candidates)
EOF
  return 1
}

python_howto() {
  local found="" syspy
  syspy="$(command -v python3 || command -v python || true)"
  if [[ -n "$syspy" ]]; then
    found=" Trouvé : ${syspy} ($(python_version_label "$syspy"))."
  fi
  cat <<EOF
Python 3.10+ est requis pour l'API FastAPI / Neon.${found}
  macOS (Homebrew) : brew install python@3.12
  Ubuntu/Debian    : sudo apt install python3 python3-venv python3-pip
  Forcer un binaire : SYNCHRO_PYTHON=/chemin/vers/python3 ./launch
  Diagnostic        : ./launch doctor
EOF
}

require_python() {
  local py
  if py="$(pick_python)"; then
    printf '%s\n' "$py"
    return 0
  fi
  if [[ -n "${SYNCHRO_PYTHON:-}" ]]; then
    die "SYNCHRO_PYTHON=${SYNCHRO_PYTHON} n'est pas un Python 3.10+ ($(python_version_label "$SYNCHRO_PYTHON"))."
  fi
  die "$(python_howto)"
}

require_node() {
  need_cmd node
  need_cmd npm
  if ! node_supported; then
    die "Node.js 20+ est requis (trouvé : $(node --version 2>/dev/null || echo '?')). https://nodejs.org/"
  fi
}

file_hash() {
  cksum "$1" | awk '{print $1" "$2}'
}

# Valeur d'une clé dotenv (premier match). Gère export, quotes, commentaire en fin de ligne.
dotenv_value() {
  local key="$1"
  local file="${2:-$ROOT/.env}"
  [[ -f "$file" ]] || return 0
  awk -v key="$key" '
    {
      line = $0
      sub(/\r$/, "", line)
      eq = index(line, "=")
      if (eq < 2) next
      left = substr(line, 1, eq - 1)
      gsub(/^[[:space:]]+/, "", left)
      gsub(/[[:space:]]+$/, "", left)
      if (left ~ /^export[[:space:]]+/) {
        sub(/^export[[:space:]]+/, "", left)
      }
      if (left != key) next
      val = substr(line, eq + 1)
      gsub(/^[[:space:]]+/, "", val)
      if (val ~ /^"/) {
        sub(/^"/, "", val)
        sub(/"[[:space:]]*(#.*)?$/, "", val)
      } else if (val ~ /^'\''/) {
        sub(/^'\''/, "", val)
        sub(/'\''[[:space:]]*(#.*)?$/, "", val)
      } else {
        sub(/[[:space:]]+#.*$/, "", val)
        sub(/[[:space:]]+$/, "", val)
      }
      print val
      exit
    }
  ' "$file"
}

apply_launch_defaults() {
  local v
  if [[ -z "$BACKEND_HOST" ]]; then
    v="$(dotenv_value HOST)"
    BACKEND_HOST="${v:-127.0.0.1}"
  fi
  if [[ -z "$BACKEND_PORT" ]]; then
    v="$(dotenv_value PORT)"
    BACKEND_PORT="${v:-8000}"
  fi
  if [[ -z "$FRONTEND_HOST" ]]; then
    v="$(dotenv_value SYNCHRO_FRONTEND_HOST)"
    FRONTEND_HOST="${v:-127.0.0.1}"
  fi
  if [[ -z "$FRONTEND_PORT" ]]; then
    v="$(dotenv_value SYNCHRO_FRONTEND_PORT)"
    FRONTEND_PORT="${v:-43147}"
  fi
  [[ "$BACKEND_PORT" =~ ^[0-9]+$ ]] || die "Port API invalide : ${BACKEND_PORT}"
  [[ "$FRONTEND_PORT" =~ ^[0-9]+$ ]] || die "Port UI invalide : ${FRONTEND_PORT}"
  FRONTEND_URL="http://${FRONTEND_HOST}:${FRONTEND_PORT}"
  BACKEND_URL="http://${BACKEND_HOST}:${BACKEND_PORT}"
  ALIVE_URL="${BACKEND_URL}/api/alive"
  HEALTH_URL="${BACKEND_URL}/api/health"
}

pid_command() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  if [[ -r "/proc/${pid}/cmdline" ]]; then
    tr '\0' ' ' <"/proc/${pid}/cmdline" | sed 's/[[:space:]]*$//'
    return 0
  fi
  ps -p "$pid" -o args= 2>/dev/null || true
}

is_synchro_pid() {
  local pid="$1" cmd="" cwd=""
  cmd="$(pid_command "$pid" || true)"
  [[ -n "$cmd" ]] || return 1
  case "$cmd" in
    *synchro.app:create_app*|*synchro.app*) return 0 ;;
    *uvicorn*)
      case "$cmd" in
        *synchro*) return 0 ;;
      esac
      ;;
    *node_modules/.bin/next*|*next/dist/*|*next-server*|*next\ dev*)
      return 0
      ;;
  esac
  if [[ -L "/proc/${pid}/cwd" ]]; then
    cwd="$(readlink "/proc/${pid}/cwd" 2>/dev/null || true)"
  fi
  if [[ -n "$cwd" && ( "$cwd" == "$ROOT" || "$cwd" == "$ROOT"/* ) ]]; then
    case "$cmd" in
      *uvicorn*|*python*|*next*|*node*) return 0 ;;
    esac
  fi
  return 1
}

is_our_api() {
  local body
  body="$(http_body "$ALIVE_URL" 2)"
  [[ "$body" == *synchro* ]]
}

kill_recorded_pid() {
  local file="$1"
  local force="${2:-0}"
  local pid
  [[ -f "$file" ]] || return 0
  pid="$(tr -d '[:space:]' <"$file" 2>/dev/null || true)"
  rm -f "$file"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  if is_synchro_pid "$pid" || [[ "$force" -eq 1 ]]; then
    kill "$pid" 2>/dev/null || true
  else
    warn "PID ${pid} (${file##*/}) n'est plus un processus Synchro — ignoré."
  fi
}

venv_pip_ok() {
  [[ -x "$1/bin/python" ]] && "$1/bin/python" -m pip --version >/dev/null 2>&1
}

bootstrap_venv_pip() {
  local venv="$1"
  need_cmd curl
  info "ensurepip absent — bootstrap pip dans le venv…"
  curl -fsSL https://bootstrap.pypa.io/get-pip.py | "$venv/bin/python" - \
    || die "Impossible d'installer pip dans le venv."
}

create_venv() {
  local py="$1" venv="$2"
  rm -rf "$venv"
  "$py" -m venv "$venv" 2>/dev/null || true
  if [[ -x "$venv/bin/python" ]]; then
    if venv_pip_ok "$venv"; then
      return 0
    fi
    bootstrap_venv_pip "$venv"
    venv_pip_ok "$venv" && return 0
  fi
  rm -rf "$venv"
  "$py" -m pip install --user virtualenv -q 2>/dev/null || true
  if "$py" -m virtualenv "$venv" 2>/dev/null && venv_pip_ok "$venv"; then
    return 0
  fi
  die "Impossible de créer le venv avec pip. Installez python3-venv (ex. apt install python3-venv) ou: pip install --user virtualenv"
}

ensure_venv() {
  local py="$1" venv="$2"
  if venv_pip_ok "$venv" && python_supported "$venv/bin/python"; then
    return 0
  fi
  if [[ -x "$venv/bin/python" ]]; then
    if python_supported "$venv/bin/python"; then
      bootstrap_venv_pip "$venv"
      venv_pip_ok "$venv" && return 0
    else
      warn "Venv Python $(python_version_label "$venv/bin/python") incompatible (il faut 3.10+). Recréation…"
    fi
    rm -rf "$venv"
  fi
  create_venv "$py" "$venv"
}

first_line() {
  awk 'NF { print; exit }'
}

listening_pids() {
  local port="$1"
  local pids=""

  if command -v lsof >/dev/null 2>&1; then
    pids="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null || true)"
  fi
  if [[ -z "$pids" ]] && command -v fuser >/dev/null 2>&1; then
    pids="$(fuser "${port}/tcp" 2>/dev/null | tr -s '[:space:]' '\n' || true)"
  fi
  if [[ -z "$pids" ]] && command -v ss >/dev/null 2>&1; then
    pids="$(ss -tlnp 2>/dev/null | awk -v p=":${port}" '
      $4 ~ p"$" {
        while (match($0, /pid=[0-9]+/)) {
          print substr($0, RSTART+4, RLENGTH-4)
          $0 = substr($0, RSTART+RLENGTH)
        }
      }' || true)"
  fi
  # Next.js (io_uring) n'apparaît souvent pas dans lsof — netstat /proc restent fiables.
  if [[ -z "$pids" ]] && command -v netstat >/dev/null 2>&1; then
    pids="$(netstat -tlnp 2>/dev/null | awk -v p=":${port}" '
      $4 ~ p"$" {
        split($7, a, "/")
        if (a[1] ~ /^[0-9]+$/) print a[1]
      }' || true)"
  fi
  if [[ -z "$pids" ]]; then
    local py
    py="$(command -v python3 || command -v python || true)"
    if [[ -n "$py" ]]; then
      pids="$("$py" - "$port" <<'PY' 2>/dev/null || true
import glob, os, sys
port = int(sys.argv[1])
needle = f":{port:04X}"
inodes: set[str] = set()
for path in ("/proc/net/tcp", "/proc/net/tcp6"):
    try:
        lines = open(path, encoding="utf-8").read().splitlines()[1:]
    except OSError:
        continue
    for line in lines:
        parts = line.split()
        if len(parts) < 10:
            continue
        if parts[3] == "0A" and parts[1].upper().endswith(needle):
            inodes.add(parts[9])
if not inodes:
    raise SystemExit(0)
seen: set[str] = set()
for fd in glob.glob("/proc/[0-9]*/fd/[0-9]*"):
    try:
        target = os.readlink(fd)
    except OSError:
        continue
    if target.startswith("socket:[") and target[8:-1] in inodes:
        pid = fd.split("/")[2]
        if pid not in seen:
            seen.add(pid)
            print(pid)
PY
)"
    fi
  fi
  printf '%s\n' "$pids"
}

free_port() {
  local port="$1"
  local force="${2:-0}"
  local pid remaining=0 foreign=0 foreign_pid=""

  while read -r pid; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    if is_synchro_pid "$pid" || [[ "$force" -eq 1 ]]; then
      remaining=1
      warn "Port ${port} occupé (PID ${pid}) — arrêt…"
      kill "$pid" 2>/dev/null || true
    else
      foreign=1
      foreign_pid="$pid"
    fi
  done <<EOF
$(listening_pids "$port")
EOF
  [[ "$remaining" -eq 1 ]] || {
    if [[ "$foreign" -eq 1 ]]; then
      warn "Port ${port} occupé par un autre processus (PID ${foreign_pid} : $(pid_command "$foreign_pid" || true))."
      return 1
    fi
    return 0
  }
  sleep 0.3
  remaining=0
  foreign=0
  while read -r pid; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    if is_synchro_pid "$pid" || [[ "$force" -eq 1 ]]; then
      remaining=1
      kill -9 "$pid" 2>/dev/null || true
    else
      foreign=1
      foreign_pid="$pid"
    fi
  done <<EOF
$(listening_pids "$port")
EOF
  if [[ "$remaining" -eq 1 ]]; then
    sleep 0.2
  fi
  if [[ "$foreign" -eq 1 ]]; then
    warn "Port ${port} encore occupé (PID ${foreign_pid} : $(pid_command "$foreign_pid" || true))."
    return 1
  fi
  return 0
}

http_ok() {
  local url="$1"
  local timeout="${2:-8}"
  if command -v curl >/dev/null 2>&1; then
    curl -sf --max-time "$timeout" "$url" >/dev/null 2>&1
    return $?
  fi
  local py
  py="$(command -v python3 || command -v python || true)"
  [[ -n "$py" ]] || return 1
  "$py" - "$url" "$timeout" <<'PY'
import sys, urllib.request
try:
    urllib.request.urlopen(sys.argv[1], timeout=float(sys.argv[2]))
except Exception:
    raise SystemExit(1)
PY
}

http_body() {
  local url="$1"
  local timeout="${2:-8}"
  if command -v curl >/dev/null 2>&1; then
    curl -sf --max-time "$timeout" "$url" 2>/dev/null || true
    return 0
  fi
  local py
  py="$(command -v python3 || command -v python || true)"
  [[ -n "$py" ]] || return 0
  "$py" - "$url" "$timeout" <<'PY' 2>/dev/null || true
import sys, urllib.request
try:
    print(urllib.request.urlopen(sys.argv[1], timeout=float(sys.argv[2])).read().decode())
except Exception:
    pass
PY
}

http_post_body() {
  local url="$1"
  local timeout="${2:-90}"
  if command -v curl >/dev/null 2>&1; then
    curl -sS --max-time "$timeout" -X POST "$url" 2>/dev/null || true
    return 0
  fi
  local py
  py="$(command -v python3 || command -v python || true)"
  [[ -n "$py" ]] || return 0
  "$py" - "$url" "$timeout" <<'PY' 2>/dev/null || true
import sys, urllib.request
req = urllib.request.Request(sys.argv[1], method="POST", data=b"")
try:
    print(urllib.request.urlopen(req, timeout=float(sys.argv[2])).read().decode())
except Exception:
    pass
PY
}

wait_http() {
  local url="$1" pid="$2"
  local retries="${3:-240}"
  local i
  for ((i = 1; i <= retries; i++)); do
    if http_ok "$url" 2; then
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      return 1
    fi
    if (( i % 20 == 0 )); then
      info "Toujours en attente de ${url}…"
    fi
    sleep 0.25
  done
  return 1
}

open_browser() {
  local url="$1"
  if [[ "$OPEN_BROWSER" -eq 0 ]]; then
    return 0
  fi
  if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && [[ "$(uname -s)" != "Darwin" ]]; then
    return 0
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  elif command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 || true
  fi
}

desktop_quote() {
  local s="$1"
  case "$s" in
    *[\ \"]*)
      s="${s//\\/\\\\}"
      s="${s//\"/\\\"}"
      printf '"%s"' "$s"
      ;;
    *)
      printf '%s' "$s"
      ;;
  esac
}

env_database_ok() {
  local url="${DATABASE_URL:-}"
  if [[ -z "$url" ]]; then
    url="$(dotenv_value DATABASE_URL)"
  fi
  [[ -n "$url" ]] || return 1
  case "$url" in
    *USER:PASSWORD*|*PASSWORD@*|*changeme*) return 1 ;;
  esac
  [[ "$url" == postgres* ]]
}

ensure_env_file() {
  if [[ ! -f "$ROOT/.env" && -f "$ROOT/.env.example" ]]; then
    cp "$ROOT/.env.example" "$ROOT/.env"
    info ".env créé depuis .env.example — collez l'URI Neon pooled dans DATABASE_URL."
  fi
}

summarize_health() {
  local body="$1"
  local py
  py="$(command -v python3 || command -v python || true)"
  [[ -n "$py" && -n "$body" ]] || return 0
  "$py" -c '
import json, sys
raw = sys.argv[1]
try:
    data = json.loads(raw)
except Exception:
    sys.exit(0)
neon = data.get("neon") or {}
if neon.get("ok"):
    latest = (data.get("latest") or {}).get("draw_date") or "?"
    draws = data.get("draws")
    ms = neon.get("latency_ms")
    extra = f", {ms} ms" if ms is not None else ""
    sync = data.get("last_sync") or {}
    finished = (sync.get("finished_at") or "")[:16].replace("T", " ")
    maj = f", MAJ {finished}" if finished else ""
    stale = " — en retard" if data.get("stale") else ""
    print(f"Neon OK ({draws} tirages, dernier {latest}{extra}{maj}{stale})")
elif neon.get("configured") is False:
    print("Neon non configuré (DATABASE_URL)")
else:
    err = (neon.get("error") or "injoignable")[:120]
    print(f"Neon indisponible — {err}")
' "$body" 2>/dev/null || true
}

ensure_graphviz_dot() {
  if command -v dot >/dev/null 2>&1; then
    ok "decisionTree : dot présent."
    return 0
  fi
  info "decisionTree : installation de Graphviz (dot)…"
  if command -v apt-get >/dev/null 2>&1; then
    if [[ "$(id -u)" -eq 0 ]]; then
      apt-get update -qq && apt-get install -y graphviz || true
    elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
      sudo -n apt-get update -qq && sudo -n apt-get install -y graphviz || true
    fi
  elif command -v brew >/dev/null 2>&1; then
    brew install graphviz || true
  fi
  if command -v dot >/dev/null 2>&1; then
    ok "decisionTree : dot installé."
  else
