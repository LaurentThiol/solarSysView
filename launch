cmd_logs() {
  local follow=0 lines=80 target="all" file
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=1; shift ;;
      --api) target="api"; shift ;;
      --ui) target="ui"; shift ;;
      -n|--lines)
        [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "Nombre de lignes invalide (ex. -n 80)."
        lines="$2"
        shift 2
        ;;
      -n*)
        lines="${1#-n}"
        [[ "$lines" =~ ^[0-9]+$ ]] || die "Nombre de lignes invalide (ex. -n80)."
        shift
        ;;
      *) die "Option inconnue pour logs : $1 (voir ./launch help)" ;;
    esac
  done
  mkdir -p "$RUN_DIR"
  local files=()
  case "$target" in
    api) files=("$RUN_DIR/backend.log") ;;
    ui) files=("$RUN_DIR/frontend.log") ;;
    *) files=("$RUN_DIR/backend.log" "$RUN_DIR/frontend.log") ;;
  esac
  local found=0 existing=()
  for file in "${files[@]}"; do
    if [[ -f "$file" ]]; then
      found=1
      existing+=("$file")
    fi
  done
  [[ "$found" -eq 1 ]] || die "Pas de journaux dans ${RUN_DIR}. Lancez ./launch d'abord."
  if [[ "$follow" -eq 1 ]]; then
    info "Suivi ${RUN_DIR} — Ctrl+C pour quitter."
    tail -n "$lines" -F "${existing[@]}"
    return 0
  fi
  for file in "${existing[@]}"; do
    printf '%s== %s ==%s\n' "$C_BOLD" "${file##*/}" "$C_RESET"
    tail -n "$lines" "$file"
  done
}

