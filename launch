    printf '%snextData : pas de venv — ./launch install%s\n' "$C_DIM" "$C_RESET"
    return 0
  fi
  local lgb_err
  if lgb_err="$(MPLBACKEND=Agg "$py" -c 'import lightgbm' 2>&1)"; then
    ok "nextData : LightGBM"
  else
    warn "nextData : LightGBM ne se charge pas."
    printf '%s%s%s\n' "$C_DIM" "$lgb_err" "$C_RESET" >&2
    if [[ "$lgb_err" == *libomp* || "$lgb_err" == *dlopen* ]]; then
      warn "Sur Mac : brew install libomp"
    else
      printf '%snextData : ./launch install-nextdata%s\n' "$C_DIM" "$C_RESET"
    fi
    return 0
  fi
  # Ne pas importer Darts / Chronos / torch ici : le chargement peut bloquer le Mac.
  if MPLBACKEND=Agg "$py" -c 'import importlib.util,sys; sys.exit(0 if importlib.util.find_spec("darts") else 1)'; then
    # Darts charge ses modèles torch dès que torch est là : sans Lightning, son import échoue.
    if MPLBACKEND=Agg "$py" -c 'import importlib.util as u,sys; sys.exit(1 if u.find_spec("torch") and not u.find_spec("pytorch_lightning") else 0)'; then
      ok "nextData : Darts installé (chargé au pronostic, pas au démarrage)"
    else
      warn "nextData : Darts ne se chargera pas, torch est là sans Lightning — ./launch install-nextdata"
    fi
  else
    printf '%snextData : Darts absent — la chaîne LightGBM directe reste disponible (./launch install-nextdata)%s\n' \
      "$C_DIM" "$C_RESET"
  fi
  if MPLBACKEND=Agg "$py" -c 'import importlib.util,sys; sys.exit(0 if importlib.util.find_spec("catboost") else 1)'; then
    ok "nextData : CatBoost installé (même lecture que LightGBM)"
  else
    printf '%snextData : CatBoost absent — ./launch install-nextdata%s\n' "$C_DIM" "$C_RESET"
  fi
  if MPLBACKEND=Agg "$py" -c 'import importlib.util,sys; sys.exit(0 if importlib.util.find_spec("chronos") and importlib.util.find_spec("torch") else 1)'; then
    ok "nextData : Chronos + torch installés"
  else
    printf '%snextData : Chronos optionnel absent — ./launch install-nextdata%s\n' "$C_DIM" "$C_RESET"
  fi
}

