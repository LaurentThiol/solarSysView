ensure_fdj_draws() {
  # Ne jamais faire échouer ./launch ici : set -euo pipefail + python -c
  # cassait toute la stack (trap EXIT) dès qu'un snippet JSON était invalide.
  info "Vérification des derniers tirages FDJ → Neon…"
  local body py line
  body="$(http_post_body "${BACKEND_URL}/api/sync/ensure" 90)" || true
  py="$ROOT/.venv/bin/python"
  if [[ ! -x "$py" ]]; then
    py="$(command -v python3 || command -v python || true)"
  fi
  if [[ -z "$py" || -z "$body" ]]; then
    warn "Rattrapage FDJ : pas de réponse (l'UI démarre quand même)."
    return 0
  fi
  local printed=0
  while IFS= read -r line || [[ -n "${line:-}" ]]; do
    printed=1
    case "$line" in
      ok:*) ok "${line#ok:}" ;;
      warn:*) warn "${line#warn:}" ;;
      *) [[ -n "$line" ]] && info "$line" ;;
    esac
  done < <(
    cd "$ROOT" && printf '%s' "$body" | "$py" -c '
from synchro.sync import format_ensure_messages
import json, sys
raw = sys.stdin.read()
try:
    data = json.loads(raw)
except Exception:
    print("warn:" + raw[:160].replace("\n", " "))
    raise SystemExit(0)
if not isinstance(data, dict):
    print("warn:réponse inattendue")
    raise SystemExit(0)
for kind, msg in format_ensure_messages(data):
    print(f"{kind}:{msg}")
' 2>/dev/null
  ) || true
  if [[ "$printed" -eq 0 ]]; then
    warn "Rattrapage FDJ : impossible d'interpréter la réponse (l'UI démarre quand même)."
  fi
  return 0
}

cmd_start() {
  local backend_pid= frontend_pid= tail_pid= stopping=0 body summary do_ensure=0

  startup_checks
  mkdir -p "$RUN_DIR"

  if [[ "$SKIP_INSTALL" -eq 0 ]]; then
    ensure_install
  elif [[ ! -x "$ROOT/.venv/bin/python" || ! -d "$ROOT/node_modules" ]]; then
    die "Dépendances manquantes. Relancez sans --skip-install (ou : ./launch install)."
  elif ! python_supported "$ROOT/.venv/bin/python"; then
    die "Le venv utilise Python $(python_version_label "$ROOT/.venv/bin/python") (incompatible). Relancez sans --skip-install."
  fi

  cmd_stop >/dev/null || true
  rm -f "$RUN_DIR/stopped"
  require_ports_free
  ensure_env_file
  ensure_local_llm

  cleanup() {
    local code=$?
    if [[ "$stopping" -eq 1 ]]; then
      return 0
    fi
    stopping=1
    trap - INT TERM EXIT
    printf '\n'
    info "Arrêt de Synchro…"
    if [[ -n "${frontend_pid:-}" ]]; then
      kill "$frontend_pid" 2>/dev/null || true
      pkill -P "$frontend_pid" 2>/dev/null || true
    fi
    if [[ -n "${backend_pid:-}" ]]; then
      kill "$backend_pid" 2>/dev/null || true
      pkill -P "$backend_pid" 2>/dev/null || true
    fi
    if [[ -n "${tail_pid:-}" ]]; then
      kill "$tail_pid" 2>/dev/null || true
      pkill -P "$tail_pid" 2>/dev/null || true
    fi
    free_port "$BACKEND_PORT" >/dev/null 2>&1 || true
    free_port "$FRONTEND_PORT" >/dev/null 2>&1 || true
    rm -f "$RUN_DIR/backend.pid" "$RUN_DIR/frontend.pid"
    wait 2>/dev/null || true
    ok "Arrêté."
    exit "$code"
  }
  trap cleanup INT TERM EXIT

  : >"$RUN_DIR/backend.log"
  : >"$RUN_DIR/frontend.log"

  info "Démarrage API ${BACKEND_URL} …"
  local extra_no_proxy="127.0.0.1,localhost,::1"
  local merged_no_proxy="${NO_PROXY:-${no_proxy:-}}"
  if [[ -z "$merged_no_proxy" ]]; then
    merged_no_proxy="$extra_no_proxy"
  elif [[ "$merged_no_proxy" != *"127.0.0.1"* ]]; then
    merged_no_proxy="${merged_no_proxy},${extra_no_proxy}"
  fi
  (
    trap '' INT
    cd "$ROOT"
    export PYTHONUNBUFFERED=1
    export MPLBACKEND=Agg
    export SYNCHRO_RUN_DIR="$RUN_DIR"
    # Un seul libomp actif. LightGBM (Homebrew), torch et scikit-learn en
    # chargent chacun un ; un fork multi-fils SIGSEGV pendant nextDataTraining.
    export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
    export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
    export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
    export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"
    export VECLIB_MAXIMUM_THREADS="${VECLIB_MAXIMUM_THREADS:-1}"
    export KMP_DUPLICATE_LIB_OK="${KMP_DUPLICATE_LIB_OK:-TRUE}"
    export NO_PROXY="$merged_no_proxy"
    export no_proxy="$merged_no_proxy"
    exec .venv/bin/python -m uvicorn synchro.app:create_app --factory --reload \
      --reload-dir synchro \
      --host "$BACKEND_HOST" --port "$BACKEND_PORT"
  ) >>"$RUN_DIR/backend.log" 2>&1 &
  backend_pid=$!
  printf '%s\n' "$backend_pid" >"$RUN_DIR/backend.pid"

  info "Démarrage UI ${FRONTEND_URL} …"
  (
    trap '' INT
    cd "$ROOT"
    export NEXT_PUBLIC_API_URL="$BACKEND_URL"
    export SYNCHRO_API_URL="$BACKEND_URL"
    export SYNCHRO_RUN_DIR="$RUN_DIR"
    export NO_PROXY="$merged_no_proxy"
    export no_proxy="$merged_no_proxy"
    exec ./node_modules/.bin/next dev --port "$FRONTEND_PORT" --hostname "$FRONTEND_HOST"
  ) >>"$RUN_DIR/frontend.log" 2>&1 &
  frontend_pid=$!
  printf '%s\n' "$frontend_pid" >"$RUN_DIR/frontend.pid"

  if ! wait_http "$ALIVE_URL" "$backend_pid" "$WAIT_API_RETRIES"; then
    warn "Journal API :"
    tail -n 40 "$RUN_DIR/backend.log" >&2 || true
    die "L'API n'a pas répondu sur ${ALIVE_URL}."
  fi
  ok "API vivante (${ALIVE_URL})"

  body="$(http_body "$HEALTH_URL" 20)"
  summary="$(summarize_health "$body")"
  if [[ -n "$summary" && "$summary" == Neon\ OK* ]]; then
    ok "Statut Neon : ${summary}"
    do_ensure=1
  elif [[ -n "$summary" ]]; then
    warn "Statut Neon : ${summary}"
  else
    warn "Statut Neon : /api/health n'a pas renvoyé de détail (l'API reste disponible)."
  fi

  if ! wait_http "$FRONTEND_URL" "$frontend_pid" "$WAIT_UI_RETRIES"; then
    warn "Journal UI :"
    tail -n 40 "$RUN_DIR/frontend.log" >&2 || true
    die "L'UI n'a pas répondu sur ${FRONTEND_URL}."
  fi
  ok "UI prête (${FRONTEND_URL})"

  printf '\n%sSynchro est lancé%s\n' "$C_BOLD" "$C_RESET"
  printf '  UI   %s\n' "$FRONTEND_URL"
  printf '  API  %s  (alive : %s · docs : %s/docs)\n' "$BACKEND_URL" "$ALIVE_URL" "$BACKEND_URL"
  printf '  LLM  %s\n' "${LLM_LAUNCH_SUMMARY:-non vérifié}"
  printf '  Logs %s  (autre terminal : ./launch logs -f)\n' "$RUN_DIR"
  printf '%s  Arrêt : bouton Quitter dans l’UI, Ctrl+C, ou ./launch stop.%s\n\n' "$C_DIM" "$C_RESET"

  open_browser "$FRONTEND_URL"

  if [[ "$do_ensure" -eq 1 ]]; then
    ensure_fdj_draws || true
  fi

  (
    tail -n +1 -F "$RUN_DIR/backend.log" 2>/dev/null | prefix_stream "[api] " "$C_MAGENTA" &
    tail -n +1 -F "$RUN_DIR/frontend.log" 2>/dev/null | prefix_stream "[ui]  " "$C_CYAN" &
    wait
  ) &
  tail_pid=$!

  while kill -0 "$backend_pid" 2>/dev/null && kill -0 "$frontend_pid" 2>/dev/null; do
    sleep 0.5
  done

  if [[ -f "$RUN_DIR/stopped" ]]; then
    exit 0
  fi

  if ! kill -0 "$backend_pid" 2>/dev/null; then
    warn "L'API s'est arrêtée. Dernières lignes :"
    tail -n 30 "$RUN_DIR/backend.log" >&2 || true
    exit 1
  fi
  warn "L'UI s'est arrêtée. Dernières lignes :"
  tail -n 30 "$RUN_DIR/frontend.log" >&2 || true
  exit 1
}

# Sourcé par les tests unitaires — ne pas dispatcher de commande.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

apply_launch_defaults

CMD="start"
PASSTHROUGH=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    start|stop|status|update|shortcut|help|doctor|install|install-vlm|install-chartisme|install-harmo|install-nextdata|install-decision-tree|restart|-h|--help)
      CMD="$1"
      shift
      ;;
    logs|chartisme-train|brain-specialist-train)
      # Le reste part tel quel (logs : -f/--api ; train : --epochs…).
      CMD="$1"
      shift
      PASSTHROUGH=("$@")
      break
      ;;
    --skip-install) SKIP_INSTALL=1; shift ;;
    --force-install) FORCE_INSTALL=1; shift ;;
    --no-open) OPEN_BROWSER=0; shift ;;
    --force) STOP_FORCE=1; shift ;;
    -*)
      die "Option inconnue : $1 (voir ./launch help)"
      ;;
    *)
      die "Argument inattendu : $1 (voir ./launch help)"
      ;;
  esac
done

case "$CMD" in
  help|-h|--help) usage ;;
  start) cmd_start ;;
  restart) cmd_restart ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  logs) cmd_logs "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}" ;;
  update) cmd_update ;;
  doctor) cmd_doctor ;;
  install) cmd_install ;;
  install-vlm) cmd_install_vlm ;;
  install-chartisme) cmd_install_chartisme ;;
  install-harmo) cmd_install_harmo ;;
  install-nextdata) cmd_install_nextdata ;;
  install-decision-tree) cmd_install_decision_tree ;;
  chartisme-train) cmd_chartisme_train "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}" ;;
  brain-specialist-train) cmd_brain_specialist_train "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}" ;;
  shortcut) cmd_shortcut ;;
  *) die "Commande inconnue : $CMD" ;;
esac
